# Local PostgreSQL connection used by docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/talentos

# Replace this value before production deployment.
# Generate one with: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-production-secret

# Public base URL of the application, used to build password-reset links
# in outgoing emails. No trailing slash.
APP_URL=http://localhost:3000

# ─── Password-recovery email (SMTP) ─────────────────────────────────
# Optional in development: without these, reset links are written to
# the server console instead of being emailed.
# Fill all four values for production so reset emails are delivered.
#
# Example (Gmail with an App Password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-16-character-app-password
#   SMTP_FROM="TalentOS <you@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TalentOS <no-reply@example.com>"
